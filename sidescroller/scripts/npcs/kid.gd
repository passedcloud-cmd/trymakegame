extends NPC
## 꼬마 피피: 말을 걸 때마다 다른 꿀팁을 알려줘요.

const TIPS := [
	["나도 크면 기사가 될 거야!", "기사님은 대시하는 동안 다치지 않는다면서? 벌레가 달려들 때 대시로 쏙 빠져나가!"],
	["있잖아, 공중에서 ↓를 누른 채 X를 누르면 아래를 벨 수 있대.", "벌레나 가시를 아래로 베면 통통 튀어 올라! 가시 위도 건널 수 있어."],
	["점프 버튼을 짧게 누르면 낮게, 길게 누르면 높게 뛴대.", "공중에서도 대시를 한 번 할 수 있어. 넓은 구덩이는 점프 + 대시!"],
	["벌레를 옆으로 베면 기사님이 살짝 뒤로 밀려나.", "그러니까 욕심내지 말고 치고 빠지기!"],
	["빛조각은 벌레가 떨어뜨려. 스테이지를 깨면 보너스도 받아!", "모은 빛조각으로 검을 강화하면 벌레를 더 빨리 물리칠 수 있어."],
]


func talk() -> void:
	var index: int = GameState.flags.get("kid_tip", 0)
	GameState.flags["kid_tip"] = (index + 1) % TIPS.size()
	Dialogue.start(npc_name, TIPS[index % TIPS.size()])
