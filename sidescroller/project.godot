; Godot 프로젝트 설정 파일이에요.
; Godot 에디터의 "프로젝트 → 프로젝트 설정" 메뉴에서 바꾸는 것을 추천해요.
; 키 설정은 "프로젝트 설정 → 입력 맵" 탭에서 바꿀 수 있어요.

config_version=5

[application]

config/name="작은 기사와 벌레 숲"
config/description="2D 횡스크롤 액션 RPG. 스테이지의 몬스터를 모두 물리치세요!"
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/game_state.gd"
Sound="*res://scripts/sound.gd"
Dialogue="*res://scenes/dialogue_box.tscn"
Transition="*res://scenes/transition.tscn"
PauseMenu="*res://scenes/pause_menu.tscn"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[gui]

theme/custom="res://assets/ui_theme.tres"

[input]

